---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'RetroHub',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'View Portfolio',
        href: 'https://myhublot.online',
        target: '_blank',
        icon: 'tabler:briefcase',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Retro Hub Hero Image' }}
  >
    <Fragment slot="title">
      Free template for <span class="hidden xl:inline">showcasing my digital world</span>
      <span class="text-accent dark:text-white"> And digital solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Your gateway to digital marketing and creative web design.</span>
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">RetroHub: Production-ready.</span>
      Suitable for Startups, Small Business, SaaS websites, Professional Portfolios, Marketing websites, Landing Pages & Blogs.
    </Fragment>
  </Hero>

  <Note title="Philosophy:" description="Simplicity, High Performance, and Data-Driven Marketing" />

  <Features
    id="features"
    tagline="Capabilities"
    title="Digital Marketing & Web Development"
    subtitle="A comprehensive portfolio highlighting technical project management and affiliate promotion."
    items={[
      {
        title: 'Technical Project Management',
        description:
          'Structuring and configuring GitHub repositories for professional websites, ensuring clean code and seamless deployment.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Affiliate Marketing Campaigns',
        description:
          'Deploying highly optimized landing pages for top-converting ClickBank and Amazon Associates products like Sleeplean and Joint Genesis.',
        icon: 'tabler:target',
      },
      {
        title: 'E-commerce Solutions',
        description:
          'Building and managing dynamic storefronts on Shopify, optimizing the user journey to maximize conversion rates.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Dropshipping Logistics',
        description:
          'Coordinating complex supply chains using platforms like CJdropshipping and Alibaba to ensure efficient product sourcing and delivery.',
        icon: 'tabler:truck',
      },
      {
        title: 'Social Media Advertising',
        description:
          'Engineering short-form video scripts and dynamic ads targeted for high engagement across TikTok and Pinterest.',
        icon: 'tabler:brand-tiktok',
      },
      {
        title: 'AI-Driven Content Creation',
        description:
          'Leveraging generative AI models and machine learning platforms to edit media, generate copy, and scale digital workflows.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Inside the Repository"
    title="Omnihub's Blueprint: Precision Meets Functionality"
    items={[
      {
        title: 'Foundational Web Development',
        description:
          'Architecting robust project structures utilizing standardized index.html, style.css, and script.js files.',
      },
      {
        title: 'Custom Theming',
        description:
          'Applying a distinct Retro Hub aesthetic to stand out in the digital landscape while maintaining professional UX/UI standards.',
      },
      {
        title: 'Cross-browser compatibility',
        description:
          'Ensuring landing pages look and function consistently across various web browsers, delivering a seamless experience for potential leads.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80',
      alt: 'Coding Environment',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices in web deployment.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
</Layout>
