---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'RetroHub',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'View Portfolio',
        href: 'https://myhublot.online',
        target: '_blank',
        icon: 'tabler:briefcase',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Retro Hub Hero Image' }}
  >
    <Fragment slot="title">
      Free template for <span class="hidden xl:inline">showcasing my digital world</span>
      <span class="text-accent dark:text-white"> And digital solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Your gateway to digital marketing and creative web design.</span>
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">RetroHub: Production-ready.</span>
      Suitable for Startups, Small Business, SaaS websites, Professional Portfolios, Marketing websites, Landing Pages & Blogs.
    </Fragment>
  </Hero>

  <Note title="Philosophy:" description="Simplicity, High Performance, and Data-Driven Marketing" />

  <Features
    id="features"
    tagline="Capabilities"
    title="Digital Marketing & Web Development"
    subtitle="A comprehensive portfolio highlighting technical project management and affiliate promotion."
    items={[
      {
        title: 'Technical Project Management',
        description:
          'Structuring and configuring GitHub repositories for professional websites, ensuring clean code and seamless deployment.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Affiliate Marketing Campaigns',
        description:
          'Deploying highly optimized landing pages for top-converting ClickBank and Amazon Associates products like Sleeplean and Joint Genesis.',
        icon: 'tabler:target',
      },
      {
        title: 'E-commerce Solutions',
        description:
          'Building and managing dynamic storefronts on Shopify, optimizing the user journey to maximize conversion rates.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Dropshipping Logistics',
        description:
          'Coordinating complex supply chains using platforms like CJdropshipping and Alibaba to ensure efficient product sourcing and delivery.',
        icon: 'tabler:truck',
      },
      {
        title: 'Social Media Advertising',
        description:
          'Engineering short-form video scripts and dynamic ads targeted for high engagement across TikTok and Pinterest.',
        icon: 'tabler:brand-tiktok',
      },
      {
        title: 'AI-Driven Content Creation',
        description:
          'Leveraging generative AI models and machine learning platforms to edit media, generate copy, and scale digital workflows.',
        icon: 'tabler:robot',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Inside the Repository"
    title="Omnihub's Blueprint: Precision Meets Functionality"
    items={[
      {
        title: 'Foundational Web Development',
        description:
          'Architecting robust project structures utilizing standardized index.html, style.css, and script.js files.',
      },
      {
        title: 'Custom Theming',
        description:
          'Applying a distinct Retro Hub aesthetic to stand out in the digital landscape while maintaining professional UX/UI standards.',
      },
      {
        title: 'Cross-browser compatibility',
        description:
          'Ensuring landing pages look and function consistently across various web browsers, delivering a seamless experience for potential leads.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=2072&q=80',
      alt: 'Coding Environment',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices in web deployment.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Rapid Landing Page Deployment',
        description: `Quickly rolling out optimized funnels to capture traffic for high-ticket affiliate offers, saving time and testing fast.`,
      },
      {
        title: 'Multiple layout possibilities',
        description:
          'Exploring various structure options for product pages to find what best drives user engagement and clicks.',
      },
      {
        title: 'Fully responsive design',
        description:
          "Ensuring optimal ad performance on mobile devices, which is critical for TikTok and Pinterest traffic.",
      },
      {
        title: 'Integration of media',
        description:
          'Seamlessly incorporating video ads and AI-generated imagery that enhance product appeal and engage visitors effectively.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Analytics Dashboard',
    }}
  >
    <Fragment slot="content">Ensure your digital campaigns yield maximum ROI.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="From concept to live domain in three streamlined steps."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Repository Setup</span>',
        description:
          "Initialize the Omnihub repository on GitHub. Establish the core directory structure and version control to lay a solid foundation for the Retro Hub portfolio.",
        icon: 'tabler:brand-github',
      },
      {
        title: 'Step 2: <span class="font-medium">Code Configuration</span>',
        description:
          "Develop and link the index.html, style.css, and script.js files. Integrate responsive design frameworks and optimize the assets for high performance.",
        icon: 'tabler:code',
      },
      {
        title: 'Step 3: <span class="font-medium">Domain Deployment</span>',
        description:
          'Connect the configured repository to the myhublot.online domain. Execute automated build workflows and push the site live to the web.',
        icon: 'tabler:world-www',
      },
      {
        title: 'Live!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Code Editor',
    }}
  />

  <Features2
    title="Marketing & E-commerce Assets"
    subtitle="Core components utilized to drive traffic, convert leads, and manage online storefronts."
    tagline="Toolkit"
    items={[
      {
        title: 'High-Converting Landing Pages',
        description: "Directing traffic efficiently. Built specifically to capture leads for ClickBank products.",
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'TikTok & Pinterest Video Ads',
        description:
          "Short-form, engaging content designed to stop the scroll and drive immediate clicks to affiliate offers.",
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Alibaba & CJdropshipping Integration',
        description:
          'Connecting reliable international suppliers directly to the storefront for seamless order fulfillment.',
        icon: 'tabler:package-export',
      },
      {
        title: 'MyStreet & Co Shopify Storefront',
        description:
          "A fully managed e-commerce environment optimized for dropshipping, customer retention, and scalable growth.",
        icon: 'tabler:building-store',
      },
      {
        title: 'Amazon Associates Campaigns',
        description:
          'Strategic placement of affiliate links within content to generate passive revenue streams.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'AI Prompt Engineering',
        description: 'Utilizing Gemini and Vertex AI to generate ad copy, test models, and streamline digital tasks.',
        icon: 'tabler:brain',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="Insights from the Omnihub"
    information={`Explore the technical documentation detailing the setup of the Omnihub repository. Learn about the seamless integration of custom HTML/CSS frameworks and the deployment process to the myhublot.online domain.`}
  />

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Common inquiries regarding our dropshipping logistics, affiliate marketing strategies, and web development processes."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'How do you source products for the Shopify store?',
        description:
          "We leverage direct integrations with CJdropshipping and Alibaba. This allows us to identify trending products, negotiate with suppliers, and establish a reliable supply chain that feeds directly into the MyStreet & Co storefront.",
      },
      {
        title: 'What is the strategy for promoting ClickBank products?',
        description:
          'For high-ticket health products like Sleeplean and Joint Genesis, we engineer engaging short-form video ads tailored for TikTok and Pinterest. These ads drive targeted traffic to custom-built landing pages designed strictly for high conversion.',
      },
      {
        title: 'What are the expected shipping timelines for dropshipped orders?',
        description:
          "Shipping times vary based on the supplier and destination. By utilizing CJdropshipping's global warehouses and prioritized ePacket lines, we aim to reduce standard international transit times to improve customer satisfaction.",
      },
      {
        title: 'What is the return policy for MyStreet & Co?',
        description:
          "We maintain a clear and compliant return policy mapped to our suppliers' terms. Customers are provided with dedicated support channels to resolve any disputes, process refunds, or handle replacements efficiently.",
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'TikTok Ad Views', amount: '250K+' },
      { title: 'Pinterest Impressions', amount: '1.2M' },
      { title: 'ClickBank Conversions', amount: '48%' },
      { title: 'GitHub Commits', amount: '342' },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'View Retro Hub Portfolio',
        href: 'https://myhublot.online',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="title">
      Explore the&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Digital World</span>
    </Fragment>

    <Fragment slot="subtitle">
      Ready to see these digital marketing and web development strategies in action? <br class="hidden md:inline" />Visit the live domain today.
    </Fragment>
  </CallToAction>
</Layout>
